[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = false

[libraries]
linux.debug.x86_64 = "res://bin/libgenesis_gdext.so"
linux.release.x86_64 = "res://bin/libgenesis_gdext.so"
windows.debug.x86_64 = "res://bin/genesis_gdext.dll"
windows.release.x86_64 = "res://bin/genesis_gdext.dll"
macos.debug = "res://bin/libgenesis_gdext.dylib"
macos.release = "res://bin/libgenesis_gdext.dylib"
