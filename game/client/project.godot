; Engine configuration file.
config_version=5

[application]
config/name="Project Genesis"
config/description="A god game where every human runs an artificial mind."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.07, 0.09, 0.11, 1)
